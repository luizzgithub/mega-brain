# mega-brain — configuração de exemplo
# Copie este arquivo para .env e ajuste os valores

# Porta da API Node.js
PORT=4144

# Caminho para o whisper-server.exe
WHISPER_SERVER_PATH=C:\Tools\whisper\whisper-server.exe

# Caminho para o modelo GGML
WHISPER_MODEL_PATH=C:\Tools\whisper\models\ggml-medium.bin

# Endereço e porta interna do whisper-server (não precisa alterar normalmente)
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8080

# Idioma padrão das transcrições (pt, en, es, auto...)
WHISPER_LANGUAGE=pt

# Threads de CPU usadas pelo whisper
WHISPER_THREADS=4

# Máximo de transcrições simultâneas (1 = sequencial, recomendado)
QUEUE_CONCURRENCY=1

# Tamanho máximo de upload em MB
MAX_FILE_SIZE_MB=50
