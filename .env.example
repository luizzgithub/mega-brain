# ============================================================
# Mega Cerebro – Variáveis de ambiente
# ============================================================
#
# proxyHub   – Provedor LLM alternativo (URL, chave, modelo, timeout).
# searxng    – Buscador web privado (URL base, timeout, parâmetros).
# scraperApi – Serviço de scraping web (URL base, timeout).
#
# mega-brain — configuração de exemplo
# Copie este arquivo para .env e ajuste os valores
# Copie este arquivo para .env e ajuste os valores

# Porta da API Node.js
PORT=4144

# Modo de execução do Whisper: cli (padrão) ou server
WHISPER_MODE=cli

# Caminho para o whisper-cli.exe (modo cli)
WHISPER_CLI_PATH=C:\Tools\whisper\whisper-cli.exe

# Pasta com modelos GGML (modo cli)
WHISPER_MODELS_DIR=C:\Tools\whisper\models

# Nome curto do modelo (ex.: medium, small, base, large-v3)
WHISPER_MODEL=medium

# --- Modo server (fallback, WHISPER_MODE=server) ---
# Caminho para o whisper-server.exe
WHISPER_SERVER_PATH=C:\Tools\whisper\whisper-server.exe

# Caminho completo do modelo GGML (modo server)
WHISPER_MODEL_PATH=C:\Tools\whisper\models\ggml-medium.bin

# Endereço e porta interna do whisper-server (só no modo server)
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8080

# Idioma padrão das transcrições (pt, en, es, auto...)
WHISPER_LANGUAGE=pt

# Threads de CPU usadas pelo whisper
WHISPER_THREADS=4

# Máximo de transcrições simultâneas (1 = sequencial, recomendado)
QUEUE_CONCURRENCY=1

# Tamanho máximo de upload em MB (vídeos podem precisar de 500+)
MAX_FILE_SIZE_MB=500

# ============================================================
# Vídeo / FFmpeg / Diarização (transcritor integrado)
# ============================================================

# Caminho do FFmpeg (deixe vazio para usar "ffmpeg" do PATH)
FFMPEG_PATH=ffmpeg

# Python para diarização pyannote
PYTHON_PATH=python

# Token HuggingFace para pyannote/speaker-diarization-3.1
HF_TOKEN=

# Diretório onde arquivos de mídia originais são armazenados
# MEDIA_DIR=data/media

# Opcional: limites de falantes na diarização
# DIARIZE_MIN_SPEAKERS=
# DIARIZE_MAX_SPEAKERS=

# ============================================================
# Assistente conversacional
# ============================================================

# Prompt do sistema para o assistente (vazio = usa o prompt padrão embutido no código)
ASSISTANT_SYSTEM_PROMPT=

# Número máximo de mensagens de contexto enviadas ao LLM por turno de conversa
ASSISTANT_MAX_CONTEXT=5

# Modelo OpenAI usado para gerar o briefing diário
ASSISTANT_BRIEFING_MODEL=gpt-4o-mini

# ============================================================
# Proxy_Hub — provedor LLM alternativo (compatível com OpenAI)
# Se PROXY_HUB_URL não for definido, o sistema usa OpenAI diretamente
# ============================================================

# URL base da API Proxy_Hub (ex: http://localhost:8080/v1)
PROXY_HUB_URL=

# Chave de API para Proxy_Hub
PROXY_HUB_API_KEY=

# Timeout em ms para requisições ao Proxy_Hub
PROXY_HUB_TIMEOUT=30000

# Atraso entre requisições na fila (ms)
PROXY_HUB_QUEUE_DELAY=200

# Modelo padrão usado via Proxy_Hub
PROXY_HUB_MODEL_DEFAULT=llama-3.3-70b-instruct

# ============================================================
# SearXNG — buscador web privado
# ============================================================

# URL base da instância SearXNG (ex: http://localhost:4000)
SEARXNG_BASE_URL=http://localhost:4000

# Path do endpoint de busca
SEARXNG_SEARCH_PATH=/search

# Timeout da requisição HTTP ao SearXNG (ms)
SEARXNG_TIMEOUT=15000

# Número de resultados a considerar para scraping de conteúdo
SEARXNG_SCRAPE_TOP_N=5

# Tamanho máximo de texto extraído por página (caracteres)
SEARXNG_MAX_TEXT_PER_PAGE=8000

# Tamanho do preview de conteúdo retornado (caracteres)
SEARXNG_CONTENT_PREVIEW_CHARS=500

# Tamanho do chunk para processamento do texto (caracteres)
SEARXNG_CHUNK_SIZE=1024

# Número de chunks com maior score retornados
SEARXNG_CHUNK_TOP_N=3

# TTL do cache em ms
SEARXNG_CACHE_TTL_MS=60000

# Número máximo de entradas no cache em memória
SEARXNG_MEMORY_CACHE_MAX_ENTRIES=1000

# ============================================================
# Scraper_API — serviço de scraping web
# ============================================================

# URL base da API Scraper (ex: http://localhost:3001)
SCRAPER_API_BASE_URL=http://localhost:3001

# Timeout da requisição ao Scraper API (ms)
SCRAPER_API_TIMEOUT_MS=30000
